ggplot(df, aes(x = dates, y = hamilton_turnout)) +
geom_line(color = "blue", size = 1.2) +
geom_point(color = "darkblue") +
labs(
title = "Absentee Voter Turnout Over Time",
x = "Date",
y = "Absentee Turnout"
) +
theme_minimal()
ggplot(df, aes(x = dates, y = hamilton_turnout)) +
geom_line(color = "blue", size = 1.2) +
geom_point(color = "darkblue") +
labs(
title = "Absentee Voter Turnout Over Time",
x = "Date",
y = "Absentee Turnout"
) +
# Set clean minimal theme
theme_minimal() +
# Y-axis from 0 to 1
ylim(0, 1) +
# Extend x-axis to include Election Day (Nov 4)
scale_x_date(
limits = c(min(df$dates), as.Date("2024-11-04")),
date_breaks = "1 week",
date_labels = "%b %d"
) +
# Add vertical line for Election Day
geom_vline(
xintercept = as.numeric(as.Date("2024-11-04")),
linetype = "dashed",
color = "red",
size = 1
) +
annotate(
"text",
x = as.Date("2024-11-04"),
y = 1,
label = "Election Day",
vjust = -0.5,
color = "red",
fontface = "bold"
)
