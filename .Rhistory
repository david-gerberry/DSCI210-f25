data_18 <- name_columns(data_18)
#### Cleaning ####
data_18 <- data_18[ , c(2, 3, 4)]
data_18 <- data_18 %>%
filter(PRECINCT %in% acs_interp_judicial$PRECINCT)
data_19 <- data_19[ , c(2, 3, 4, 12, 13)]
