life_mean <- 69.787
life_se <- 9.2504
life_n <- 55
life_t_stat <- 2.005
life_error <- (life_t_stat * life_se) / sqrt(life_n)
c(life_mean - life_error, life_mean + life_error)
life_expectancy <- c(life_mean - life_error, life_mean + life_error)
xbar <- 69.787
hypothesis_mean <- 68
s <- 9.2504
n <- 55
se <- s / sqrt(n)
t_stat <- (xbar - hypothesis_mean) / s
t_crit <- qt(0.95, df = n -1)
t_stat > t_crit
