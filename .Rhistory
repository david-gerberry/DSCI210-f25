library(sf)
library(ggplot2)
library(dplyr)
library(tidycensus)
library(tidyverse)
# 1. Read shapefiles (replace paths with your actual files)
judicial_boundaries <- st_read("shapefiles/judicial_boundary.shp")
judicial_precincts  <- st_read("shapefiles/judicial_precincts.shp")
