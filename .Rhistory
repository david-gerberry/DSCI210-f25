#### Making Data Frame ####
days_2025 <- c(1:28)
days_2021 <- c(30:0)
days_2023 <- c(33:0)
dates <- c(
seq(as.Date("2025-10-07"), as.Date("2025-11-03"), by = "day"),
seq(as.Date("2023-10-05"), as.Date("2023-11-07"), by = "day"),
seq(as.Date("2021-10-05"), as.Date("2021-11-04"), by = "day"))
df <- data.frame(
date = dates,
turnout = NA_real_,
turnout_R = NA_real_,
turnout_D = NA_real_,
turnout_U = NA_real_,
total_R = NA_real_,
total_D = NA_real_,
total_U = NA_real_
)
rm(dates)
days_2025 <- c(1:28)
days_2021 <- c(30:0)
days_2023 <- c(33:0)
dates <- c(
seq(as.Date("2025-10-07"), as.Date("2025-11-03"), by = "day"),
seq(as.Date("2023-10-05"), as.Date("2023-11-07"), by = "day"),
seq(as.Date("2021-10-05"), as.Date("2021-11-04"), by = "day"))
df_early <- data.frame(
date = dates,
turnout = NA_real_,
turnout_R = NA_real_,
turnout_D = NA_real_,
turnout_U = NA_real_,
total_R = NA_real_,
total_D = NA_real_,
total_U = NA_real_
)
rm(dates)
#### Turnout Creator ####
i <- 28
for (date in days_2025) {
df$turnout[i]    <- turnout_by_date_2025(date)
df$turnout_R[i]  <- turnout_by_date_2025(date, "R")
df$turnout_D[i]  <- turnout_by_date_2025(date, "D")
df$turnout_U[i]  <- turnout_by_date_2025(date, "U")
df$total_R[i]  <- total_votes_2025(date, "R")
df$total_D[i]  <- total_votes_2025(date, "D")
df$total_U[i]  <- total_votes_2025(date, "U")
i <- i - 1
}
i <- 29
for (date in days_2023) {
df$turnout[i]    <- turnout_by_date_2023(date)
