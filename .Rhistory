`10-19` <- df_row$age_10_19
`20-29` <- df_row$age_20_29
`30-39` <- df_row$age_30_39
`40-49` <- df_row$age_40_49
`50-59` <- df_row$age_50_59
`60-69` <- df_row$age_60_69
`70-79` <- df_row$age_70_79
`80+` <- df_row$age_80plus
