turnout_by_date_2025 <- function(date=28){
df <- hamilton_df %>%
filter(days_before >= !!date)
votes_cast <- nrow(df)
turnout <- votes_cast/nrow(hamilton_df)
return(turnout)
}
turnout_by_date_2025(21)
turnout_by_date_2025(22)
